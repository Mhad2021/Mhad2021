# ---------------------------------------------------------------------------
# Presence — PRODUCTION configuration template.
#
#   cp .env.example .env    (at the repository root, next to docker-compose.yml)
#
# Every CHANGE_ME below must be replaced. The server refuses to start in
# production with the placeholders still in place.
#
# For local evaluation you do NOT want this file — see the quick start in
# README.md, which uses SQLite and needs three lines.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false
BASE_URL=https://presence.yourcompany.com

# --- Database --------------------------------------------------------------
# The password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql+psycopg://presence:CHANGE_ME@db:5432/presence
POSTGRES_DB=presence
POSTGRES_USER=presence
POSTGRES_PASSWORD=CHANGE_ME

# --- Security --------------------------------------------------------------
# Signs dashboard sessions. Rotating it signs everyone out.
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_64_RANDOM_HEX_CHARACTERS

# Encrypts Slack/SMTP credentials at rest. Rotating it makes existing
# integration credentials unreadable and they must be re-entered.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

SECURE_COOKIES=true

# Comma-separated. Set this to your real domain; "*" accepts any Host header.
TRUSTED_HOSTS=presence.yourcompany.com

# Only needed if a separate front-end origin calls the API. Leave blank otherwise.
CORS_ORIGINS=

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# --- Monitoring ------------------------------------------------------------
# How often every open session is re-evaluated for idle, overruns and offline.
MONITOR_INTERVAL_SECONDS=30
# How often the manager's live board refreshes.
SSE_POLL_SECONDS=5

# --- Email -----------------------------------------------------------------
# Used by the email notification channel. Slack is usually easier to set up
# and more likely to actually be read, so this is optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=presence@yourcompany.com
SMTP_USE_TLS=true

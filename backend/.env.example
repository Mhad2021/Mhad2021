# ---------------------------------------------------------------------------
# Presence — environment configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false
BASE_URL=https://presence.yourcompany.com

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://presence:CHANGE_ME@db:5432/presence

# --- Security --------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_64_RANDOM_HEX_CHARACTERS
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
SECURE_COOKIES=true
TRUSTED_HOSTS=presence.yourcompany.com

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# --- Monitoring ------------------------------------------------------------
# How often the server re-evaluates every open session.
MONITOR_INTERVAL_SECONDS=30
# How often the live board refreshes for managers.
SSE_POLL_SECONDS=5

# --- Email (used by the email notification channel) ------------------------
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USERNAME=presence@yourcompany.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=presence@yourcompany.com
SMTP_USE_TLS=true
